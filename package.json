{
  "name": "rashinban2025",
  "version": "1.1.0",
  "description": "Overlays and tampermonkey scripts for [Rashinban 2025](https://rashinban.org/).",
  "type": "module",
  "scripts": {
    "build:tampermonkey": "node tampermonkeys/scripts/build-userscript.js",
    "build:tm": "node tampermonkeys/scripts/build-userscript.js",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve": "http-server . -p 4173 -s -c-1",
    "test:js": "vitest run --pool forks",
    "test:ui": "playwright test",
    "test:ui-update": "playwright test --update-snapshots"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,css,scss,less,md,html,json,yml,yaml}": "prettier --write"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "happy-dom": "^18.0.1",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "vitest": "^3.2.4"
  },
  "package-lock": "true"
}
